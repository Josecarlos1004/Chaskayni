APP_NAME=Chaskayni
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
PHOTON_REVERSE_URL=https://photon.komoot.io/reverse
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chaskayni
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_DRIVER=local
FILESYSTEM_PRIVATE_DRIVER=local
FILESYSTEM_PUBLIC_VISIBILITY=public

# MAIL_MAILER=log solo escribe los mensajes en los registros.
# Para envío real, configura SMTP en tu .env privado o en el servidor.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@chaskayni.local"
MAIL_FROM_NAME="${APP_NAME}"